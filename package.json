{
  "name": "@lpm.dev/neo.highlight",
  "version": "1.4.0",
  "description": "Zero-dependency syntax highlighter - Fast, modern, tree-shakeable with React adapter and auto-scan support",
  "type": "module",
  "author": "neo",
  "license": "MIT",
  "sideEffects": [
    "./dist/worker/index.js",
    "./dist/worker/index.cjs"
  ],
  "keywords": [
    "syntax",
    "highlight",
    "code",
    "prism",
    "highlightjs",
    "react",
    "typescript",
    "esm",
    "tree-shakeable",
    "zero-dependency",
    "modern",
    "neo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.highlight"
  },
  "homepage": "https://github.com/ne-ooo/neo.highlight#readme",
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.highlight/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla/index.d.ts",
        "default": "./dist/vanilla/index.js"
      },
      "require": {
        "types": "./dist/vanilla/index.d.cts",
        "default": "./dist/vanilla/index.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker/index.d.ts",
        "default": "./dist/worker/index.js"
      },
      "require": {
        "types": "./dist/worker/index.d.cts",
        "default": "./dist/worker/index.cjs"
      }
    },
    "./grammars": {
      "import": {
        "types": "./dist/grammars/index.d.ts",
        "default": "./dist/grammars/index.js"
      },
      "require": {
        "types": "./dist/grammars/index.d.cts",
        "default": "./dist/grammars/index.cjs"
      }
    },
    "./grammars/*": {
      "import": {
        "types": "./dist/grammars/*.d.ts",
        "default": "./dist/grammars/*.js"
      },
      "require": {
        "types": "./dist/grammars/*.d.cts",
        "default": "./dist/grammars/*.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes/index.d.ts",
        "default": "./dist/themes/index.js"
      },
      "require": {
        "types": "./dist/themes/index.d.cts",
        "default": "./dist/themes/index.cjs"
      }
    },
    "./themes/*": {
      "import": {
        "types": "./dist/themes/*.d.ts",
        "default": "./dist/themes/*.js"
      },
      "require": {
        "types": "./dist/themes/*.d.cts",
        "default": "./dist/themes/*.cjs"
      }
    },
    "./package.json": "./package.json",
    "./worker/core": {
      "import": {
        "types": "./dist/worker/core.d.ts",
        "default": "./dist/worker/core.js"
      },
      "require": {
        "types": "./dist/worker/core.d.cts",
        "default": "./dist/worker/core.cjs"
      }
    },
    "./worker/client": {
      "import": {
        "types": "./dist/worker/client.d.ts",
        "default": "./dist/worker/client.js"
      },
      "require": {
        "types": "./dist/worker/client.d.cts",
        "default": "./dist/worker/client.cjs"
      }
    },
    "./experimental": {
      "import": {
        "types": "./dist/experimental/index.d.ts",
        "default": "./dist/experimental/index.js"
      },
      "require": {
        "types": "./dist/experimental/index.d.cts",
        "default": "./dist/experimental/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".lpm/skills",
    "README.md",
    "CHANGELOG.md",
    "docs/grammar-accuracy.md",
    "LICENSE",
    "docs/efficiency.md",
    "docs/render-hooks.md",
    "docs/word-highlighting.md",
    "CONTRIBUTING.md",
    "docs/workers.md",
    "docs/incremental.md"
  ],
  "scripts": {
    "build": "tsup",
    "package:check": "lpm run build && lpm publish --check --yes",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:grammar-accuracy": "vitest run test/unit/grammars/javascript-context.test.ts test/unit/grammars/markup-boundaries.test.ts test/unit/grammars/javascript-accuracy.test.ts test/unit/grammars/python-accuracy.test.ts test/unit/grammars/css-accuracy.test.ts test/unit/grammars/markup-accuracy.test.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/package-smoke.mjs",
    "test:regex-safety": "node test/regex-safety.mjs",
    "test:resource-safety": "node test/resource-safety.mjs",
    "bench": "vitest bench --run test/benchmarks",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "security:audit": "lpm audit --level info --fail-on vuln",
    "security:signatures": "lpm audit signatures",
    "release:check": "lpm run check:release-metadata && lpm run clean && lpm run security:audit && lpm run security:signatures && lpm run type-check && lpm run test:coverage && lpm run build && lpm run test:regex-safety && lpm run test:resource-safety && lpm run test:package && lpm run test:workers && lpm run check:worker-bundles && lpm run test:incremental-workers",
    "prepublishOnly": "lpm run release:check",
    "bench:efficiency": "node test/efficiency.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "test:workers": "node test/worker-runtime.mjs",
    "check:worker-bundles": "node test/worker-bundles.mjs",
    "test:worker-browser": "node test/worker-browser.mjs",
    "test:incremental": "vitest run test/unit/stream && node test/stream-runtime.mjs",
    "test:incremental-workers": "node test/stream-runtime.mjs"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/node": "^18.19.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "highlight.js": "^11.11.1",
    "jsdom": "^24.0.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "4.1.11"
  },
  "lpm": {
    "overrides": {
      "tsup>esbuild": "0.28.2"
    }
  }
}
